# microservice specific routes

->         /hmrc-frontend           hmrcfrontend.Routes
GET        /assets/*file            controllers.Assets.versioned(path = "/public", file: Asset)

GET        /enter-your-organisation-address    uk.gov.hmrc.disaaccountfrontend.controllers.EnterYourOrganisationAddressController.onPageLoad()
POST       /enter-your-organisation-address    uk.gov.hmrc.disaaccountfrontend.controllers.EnterYourOrganisationAddressController.onSubmit()

GET        /organisation-telephone-number      uk.gov.hmrc.disaaccountfrontend.controllers.orgdetails.OrganisationTelephoneNumberController.onPageLoad()
POST       /organisation-telephone-number      uk.gov.hmrc.disaaccountfrontend.controllers.orgdetails.OrganisationTelephoneNumberController.onSubmit()

GET        /trading-name                       uk.gov.hmrc.disaaccountfrontend.controllers.orgdetails.TradingNameController.onPageLoad()
POST       /trading-name                       uk.gov.hmrc.disaaccountfrontend.controllers.orgdetails.TradingNameController.onSubmit()

GET        /innovative-financial-products      uk.gov.hmrc.disaaccountfrontend.controllers.InnovativeFinancialProductsController.onPageLoad()
POST       /innovative-financial-products      uk.gov.hmrc.disaaccountfrontend.controllers.InnovativeFinancialProductsController.onSubmit()

GET        /peer-to-peer-loans                  uk.gov.hmrc.disaaccountfrontend.controllers.PeerToPeerPlatformController.onPageLoad()
POST       /peer-to-peer-loans                  uk.gov.hmrc.disaaccountfrontend.controllers.PeerToPeerPlatformController.onSubmit()

GET        /financial-organisation              uk.gov.hmrc.disaaccountfrontend.controllers.FinancialOrganisationController.onPageLoad()
POST       /financial-organisation              uk.gov.hmrc.disaaccountfrontend.controllers.FinancialOrganisationController.onSubmit()

GET        /unauthorised                       uk.gov.hmrc.disaaccountfrontend.controllers.UnauthorisedController.onPageLoad()

GET        /change-of-circumstances            uk.gov.hmrc.disaaccountfrontend.controllers.ChangeOfCircumstancesController.onPageLoad()

GET        /refresh-session                    uk.gov.hmrc.disaaccountfrontend.controllers.KeepAliveController.keepAlive()

GET        /sign-out                           uk.gov.hmrc.disaaccountfrontend.controllers.auth.AuthController.signOut()
GET        /signed-out                         uk.gov.hmrc.disaaccountfrontend.controllers.auth.SignedOutController.onPageLoad()
